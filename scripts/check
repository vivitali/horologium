#!/usr/bin/env bash
# Fast gate: format check, vet, unit tests. Exits non-zero on any failure.
set -euo pipefail
cd "$(dirname "$0")/.."
unformatted=$(gofmt -l ./cmd ./internal ./pkg)
if [[ -n "$unformatted" ]]; then
    echo "gofmt needed:" >&2
    echo "$unformatted" >&2
    exit 1
fi
go vet ./...
go test ./... -count=1
