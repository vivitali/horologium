# Winnipeg Tech Events configuration
# Copy this file to deploy/.env (gitignored) and fill in your values
# for local runs and the deploy/deploy.sh script.

# --- Required: main bot ---
TELEGRAM_BOT_TOKEN=your_main_bot_token_here
TELEGRAM_CHAT_ID=your_main_chat_id_here

# --- Meetup bot (separate Telegram bot, separate Lambda) ---
# Add it to the same group as the events bot and make it an admin with
# "Pin messages" so it can pin the monthly summary.
TELEGRAM_MEETUP_BOT_TOKEN=
TELEGRAM_MEETUP_CHAT_ID=
ANTHROPIC_API_KEY=

# --- Tuning ---
CITY=Winnipeg
CATEGORIES=tech
PERIOD_DAYS=30

# --- Local web UI ---
PORT=8080

# --- Safety switch ---
# When true, the digest is built but never posted to Telegram.
TEST_MODE=false

# --- GitHub Actions ---
# Set these in GitHub: Settings -> Secrets and variables -> Actions
# Secrets:   AWS_ACCOUNT_ID, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
#            TELEGRAM_MEETUP_BOT_TOKEN, TELEGRAM_MEETUP_CHAT_ID, ANTHROPIC_API_KEY
# Variables: CITY, CATEGORIES, PERIOD_DAYS, TEST_MODE (all optional)
